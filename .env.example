# Copy this file to .env in the repository root and choose a local password.
# Docker Compose and Spring Boot both read this file. Keep values unquoted.

# Dedicated Helpdesk PostgreSQL instance (5432 and 5433 may serve other projects).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-password

# One database per service.
TICKET_DB=ticket_db
AUTH_DB=auth_db
NOTIFICATION_DB=notification_db

# HTTP ports. Ticket Service uses 18081 to avoid an existing listener on 8081.
TICKET_SERVICE_PORT=18081
NOTIFICATION_SERVICE_PORT=8082
AUTH_SERVICE_PORT=8083

# Existing local-development JPA settings.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# Generate with: openssl rand -base64 32. The same key is used by auth and tickets.
JWT_SECRET=replace-with-generated-base64-secret
JWT_ISSUER=enterprise-helpdesk-auth
JWT_AUDIENCE=enterprise-helpdesk
JWT_TTL_SECONDS=3600
# Optional browser portal overrides; defaults follow the service ports above.
# AUTH_SERVICE_URL=http://localhost:8083
# AUTH_ALLOWED_ORIGINS=http://localhost:18081,http://127.0.0.1:18081
